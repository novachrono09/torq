        while True:
            try:
                cols, lines = os.get_terminal_size()
            except Exception:
                cols, lines = 80, 24

            filtered = all_items
            target_tier = tier_filters[current_tier_idx]
            if target_tier != "ALL":
                filtered = [x for x in filtered if x.get("tier") == target_tier]

            target_source = source_filters[current_source_idx]
            if target_source != "ALL":
                filtered = [x for x in filtered if x.get("source") == target_source]

            if search_filter:
                filtered = [x for x in filtered if search_filter.lower() in x.get("title", "").lower()]

            total_items = len(filtered)
            if total_items == 0:
                selected_idx = 0
            else:
                selected_idx = max(0, min(selected_idx, total_items - 1))

            items_per_page = max(3, (lines - 7) // 2)
            total_pages = max(1, math.ceil(total_items / items_per_page)) if total_items > 0 else 1
            current_page = (selected_idx // items_per_page) + 1 if total_items > 0 else 1

            start_idx = (current_page - 1) * items_per_page
            end_idx = min(start_idx + items_per_page, total_items)

            frame = [MOVE_TOP]

            tier_label = QUALITY_SHORT.get(target_tier, target_tier)
            q_disp = initial_query[:18]
            hdr = f"{BOLD}{CYAN}⚡ TORQ TUI{RESET} | {BOLD}{YELLOW}{q_disp}{RESET} | Tier: {MAGENTA}[{tier_label}]{RESET} | Src: {BLUE}[{target_source}]{RESET} | Pg: {BOLD}{current_page}/{total_pages}{RESET}"
            frame.append(hdr[:cols] + CLEAR_LINE)

            if search_filter:
                frame.append(f"{YELLOW}Filter (/): {search_filter}{RESET}" + CLEAR_LINE)
            else:
                frame.append(f"{DIM}━" * min(cols - 1, 78) + f"{RESET}" + CLEAR_LINE)

            if total_items == 0:
                frame.append(f"\n   {YELLOW}No torrents found matching active filters.{RESET}" + CLEAR_LINE)
                frame.append(f"   {DIM}Press 't' to reset quality tier or 's' to reset source.{RESET}" + CLEAR_LINE)
            else:
                current_section = None
                for idx in range(start_idx, end_idx):
                    item = filtered[idx]
                    tier = item.get("tier", "Standard / General Media")
                    is_active = (idx == selected_idx)

                    if target_tier == "ALL" and tier != current_section:
                        current_section = tier
                        color = QUALITY_COLORS.get(tier, BOLD)
                        frame.append(f"{color}── {tier} ──{RESET}" + CLEAR_LINE)

                    s_color = GREEN if item["seeders"] > 5 else (YELLOW if item["seeders"] > 0 else RED)
                    src_tag = f"{MAGENTA}[{item['source']}]{RESET}"
                    title_display = item["title"][:cols - 14]

                    if is_active:
                        line1 = f"{HL_ARROW} {HL_BG}[{idx + 1:2d}] {title_display}{RESET}"
                        line2 = f"   {src_tag} Size: {YELLOW}{item['size']}{RESET} | Seeders: {s_color}{item['seeders']}{RESET} | Leechers: {DIM}{item['leechers']}{RESET} | {DIM}{item['category']}{RESET}"
                    else:
                        line1 = f"   {CYAN}[{idx + 1:2d}]{RESET} {title_display}"
                        line2 = f"   {src_tag} Size: {YELLOW}{item['size']}{RESET} | Seeders: {s_color}{item['seeders']}{RESET} | Leechers: {DIM}{item['leechers']}{RESET} | {DIM}{item['category']}{RESET}"

                    frame.append(line1 + CLEAR_LINE)
                    frame.append(line2 + CLEAR_LINE)

            used = len(frame)
            for _ in range(max(0, lines - used - 2)):
                frame.append(CLEAR_LINE)

            if status_msg:
                frame.append(f"{GREEN}✔ {status_msg}{RESET}" + CLEAR_LINE)
                status_msg = ""
            else:
                frame.append(f"{DIM}━" * min(cols - 1, 78) + f"{RESET}" + CLEAR_LINE)

            footer = (
                f"{BOLD}[▲/▼]{RESET} Nav  "
                f"{BOLD}[Enter/d]{RESET} Download  "
                f"{BOLD}[Q]{RESET} Queue  "
                f"{BOLD}[m]{RESET} Magnet  "
                f"{BOLD}[t]{RESET} Tier  "
                f"{BOLD}[s]{RESET} Source  "
                f"{BOLD}[q]{RESET} Quit"
            )
            frame.append(footer[:cols] + CLEAR_LINE)

            sys.stdout.write("\n".join(frame))
            sys.stdout.flush()

            k = read_key()

            if k in ('q', 'Q', 'QUIT'):
                break
            elif k in ('UP', 'k') and selected_idx > 0:
                selected_idx -= 1
            elif k in ('DOWN', 'j') and selected_idx < total_items - 1:
                selected_idx += 1
            elif k in ('RIGHT', 'l', 'n') and current_page < total_pages:
                selected_idx = min(start_idx + items_per_page, total_items - 1)
            elif k in ('LEFT', 'h', 'p') and current_page > 1:
                selected_idx = max(0, start_idx - items_per_page)
            elif k in ('t', 'TAB'):
                current_tier_idx = (current_tier_idx + 1) % len(tier_filters)
                selected_idx = 0
            elif k == 's':
                current_source_idx = (current_source_idx + 1) % len(source_filters)
                selected_idx = 0
            elif k == 'Q':
                sys.stdout.write("\033[?25h")
                queue_manager(dest_dir)
                sys.stdout.write("\033[?25l" + CLEAR_SCREEN)
            elif k == '/':
                sys.stdout.write("\033[?25h\n\033[KEnter filter text (Enter to apply, empty to clear): ")
                sys.stdout.flush()
                try:
                    search_filter = input().strip()
                except Exception:
                    search_filter = ""
                sys.stdout.write("\033[?25l")
                selected_idx = 0
            elif k in ('m', 'M') and total_items > 0:
                item = filtered[selected_idx]
                copied = copy_to_clipboard(item["magnet"])
                if copied:
                    status_msg = f"Magnet copied to clipboard! ({item['title'][:32]}...)"
                else:
                    status_msg = f"Magnet: {item['magnet'][:50]}..."
            elif k in ('ENTER', 'd', 'D') and total_items > 0:
                item = filtered[selected_idx]
                has_space, free_b = check_disk_space(dest_dir, item.get("raw_size", 0))
                if not has_space:
                    sys.stdout.write("\033[?25h\n")
                    print(f"\n{BOLD}{RED}⚠️  DISK SPACE WARNING{RESET}")
                    print(f"Torrent Size: {YELLOW}{item['size']}{RESET} | Free on /sdcard: {RED}{format_bytes(free_b)}{RESET}")
                    proceed = input(f"{BOLD}Proceed anyway? [y/N]: {RESET}").strip().lower()
                    if proceed not in ('y', 'yes'):
                        sys.stdout.write("\033[?25l" + CLEAR_SCREEN)
                        continue
                download_dashboard(item, dest_dir)
                sys.stdout.write(CLEAR_SCREEN)
    finally:
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(
        description="⚡ torq - Lightweight, keyboard-driven multi-tracker media engine for your terminal",
        epilog="""Examples:
  torq "Doraemon"
  torq queue
  torq -q highest "Oppenheimer"
  torq --update
"""
    )
    parser.add_argument("query", nargs="*", help="Search terms or 'queue'")
    parser.add_argument("-s", "--source", choices=["all", "tpb", "nyaa"], default="all",
                        help="Tracker source to query (default: all)")
    parser.add_argument("-q", "--quality", choices=["all", "highest", "high", "medium", "low"], default="all",
                        help="Filter by quality section (highest=4K/Remux, high=1080p, medium=720p, low=480p)")
    parser.add_argument("-l", "--list", action="store_true",
                        help="List search results with sections and exit")
    parser.add_argument("-m", "--magnet", action="store_true",
                        help="Print magnet link of top result and exit")
    parser.add_argument("-d", "--download", action="store_true",
                        help="Instantly download top result via loading dashboard")
    parser.add_argument("-u", "--update", action="store_true",
                        help="Check for and install updates from GitHub")
    parser.add_argument("-v", "--version", action="version", version=f"torq {VERSION}")

    args = parser.parse_args()

    if args.update:
        self_update()
        sys.exit(0)

    query_str = " ".join(args.query).strip()

    if query_str.lower() in ("queue", "q"):
        dest_dir = get_downloads_dir()
        queue_manager(dest_dir)
        sys.exit(0)

    if not query_str:
        try:
            query_str = input(f"{BOLD}Search torrents for (or 'queue'): {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            sys.exit(0)

    if not query_str:
        print(f"{RED}No search query provided.{RESET}")
        sys.exit(1)

    if query_str.lower() in ("queue", "q"):
        dest_dir = get_downloads_dir()
        queue_manager(dest_dir)
        sys.exit(0)

    print(f"{CYAN}Searching multi-trackers for '{query_str}'...{RESET}")

    raw_results = []
    if args.source in ("all", "tpb"):
        raw_results.extend(search_tpb(query_str))
    if args.source in ("all", "nyaa"):
        raw_results.extend(search_nyaa(query_str))

    if not raw_results:
        print(f"{YELLOW}No results found for '{query_str}'.{RESET}")
        sys.exit(0)

    if args.quality != "all":
        q_map = {
            "highest": "Highest Quality (4K / UHD / Remux)",
            "high": "High Quality (1080p / FHD / BD)",
            "medium": "Medium Quality (720p / HD)",
            "low": "Low Quality (480p / SD / CAM)"
        }
        target_tier = q_map[args.quality]
        raw_results = [r for r in raw_results if r.get("tier") == target_tier]
        if not raw_results:
            print(f"{YELLOW}No results found in {target_tier} section for '{query_str}'.{RESET}")
            sys.exit(0)

    sorted_results = []
    for tier in QUALITY_ORDER:
        tier_items = [r for r in raw_results if r.get("tier") == tier]
        tier_items.sort(key=lambda x: x.get("seeders", 0), reverse=True)
        sorted_results.extend(tier_items)

    remainder = [r for r in raw_results if r.get("tier") not in set(QUALITY_ORDER)]
    remainder.sort(key=lambda x: x.get("seeders", 0), reverse=True)
    sorted_results.extend(remainder)

    if args.magnet:
        print(sorted_results[0]["magnet"])
        sys.exit(0)

    if args.download:
        dest = get_downloads_dir()
        download_dashboard(sorted_results[0], dest)
        sys.exit(0)

    if args.list or not sys.stdin.isatty():
        current_section = None
        for idx, item in enumerate(sorted_results[:30], 1):
            tier = item.get("tier", "Standard / General Media")
            if tier != current_section:
                current_section = tier
                color = QUALITY_COLORS.get(tier, BOLD)
                print(f"\n{color}━━━ {tier} ━━━{RESET}")
            s_color = GREEN if item["seeders"] > 5 else (YELLOW if item["seeders"] > 0 else RED)
            src_tag = f"{MAGENTA}[{item['source']}]{RESET}"
            print(f" [{idx:2d}] {src_tag} {BOLD}{item['title']}{RESET}")
            print(f"      Size: {YELLOW}{item['size']}{RESET} | Seeders: {s_color}{item['seeders']}{RESET} | Leechers: {DIM}{item['leechers']}{RESET}")
        print()
        sys.exit(0)

    run_tui(sorted_results, initial_query=query_str)

if __name__ == "__main__":
    main()
