def read_key():
    if not sys.stdin.isatty():
        ch = sys.stdin.read(1)
        return ch if ch else 'q'
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            time.sleep(0.06)
            os.set_blocking(fd, False)
            seq = ""
            while True:
                more = sys.stdin.read(1)
                if not more:
                    break
                seq += more
            os.set_blocking(fd, True)

            if not seq:
                return 'ESC'
            if seq in ('[A', 'OA'): return 'UP'
            elif seq in ('[B', 'OB'): return 'DOWN'
            elif seq in ('[C', 'OC'): return 'RIGHT'
            elif seq in ('[D', 'OD'): return 'LEFT'
            return f'ESC_{seq}'
        elif ch in ('\r', '\n'):
            return 'ENTER'
        elif ch == '\t':
            return 'TAB'
        elif ch in ('\x03', '\x04'):
            return 'QUIT'
        elif ch == ' ':
            return 'SPACE'
        elif ch in ('\x7f', '\x08'):
            return 'BACKSPACE'
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)

RPC_PORT = 6800
RPC_SECRET = "torq_secret_session"

class Aria2Session:
    @staticmethod
    def ensure_daemon(dest_dir):
        try:
            req = urllib.request.Request(
                f"http://127.0.0.1:{RPC_PORT}/jsonrpc",
                data=json.dumps({"jsonrpc": "2.0", "id": "p", "method": "aria2.getVersion", "params": [f"token:{RPC_SECRET}"]}).encode(),
                headers={"Content-Type": "application/json"}
            )
            urllib.request.urlopen(req, timeout=0.5)
            return
        except Exception:
            pass

        trackers_arg = ",".join(TOP_TRACKERS)
        cmd = [
            "aria2c",
            "--enable-rpc=true",
            f"--rpc-listen-port={RPC_PORT}",
            f"--rpc-secret={RPC_SECRET}",
            f"--dir={dest_dir}",
            "--seed-time=0",
            "--file-allocation=none",
            "--bt-max-peers=140",
            "--bt-request-peer-speed-limit=0",
            "--max-connection-per-server=16",
            "--split=16",
            "--min-split-size=1M",
            "--piece-length=1M",
            "--enable-dht=true",
            "--enable-dht6=true",
            "--bt-enable-lpd=true",
            "--enable-peer-exchange=true",
            f"--bt-tracker={trackers_arg}",
            "--async-dns=true",
            "--summary-interval=0",
            "--quiet=true",
            "--daemon=true"
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.5)

    @staticmethod
    def rpc(method, params=None):
        if params is None:
            params = []
        payload = json.dumps({
            "jsonrpc": "2.0",
            "id": "torq",
            "method": method,
            "params": [f"token:{RPC_SECRET}"] + params
        }).encode("utf-8")
        req = urllib.request.Request(
            f"http://127.0.0.1:{RPC_PORT}/jsonrpc",
            data=payload,
            headers={"Content-Type": "application/json"}
        )
        try:
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                data = json.loads(resp.read().decode())
                return data.get("result")
        except Exception:
            return None

    @staticmethod
    def add_magnet(magnet):
        return Aria2Session.rpc("aria2.addUri", [[magnet]])

    @staticmethod
    def pause(gid):
        return Aria2Session.rpc("aria2.pause", [gid])

    @staticmethod
    def unpause(gid):
        return Aria2Session.rpc("aria2.unpause", [gid])

    @staticmethod
    def remove(gid):
        return Aria2Session.rpc("aria2.remove", [gid])

    @staticmethod
    def get_current_task():
        actives = Aria2Session.rpc("aria2.tellActive") or []
        for a in actives:
            files = a.get("files", [])
            if files and not files[0].get("path", "").startswith("[METADATA]"):
                return a
        if actives:
            return actives[0]

        waiting = Aria2Session.rpc("aria2.tellWaiting", [0, 5]) or []
        for w in waiting:
            files = w.get("files", [])
            if files and not files[0].get("path", "").startswith("[METADATA]"):
                return w

        stopped = Aria2Session.rpc("aria2.tellStopped", [0, 5]) or []
        for s in stopped:
            files = s.get("files", [])
            if files and not files[0].get("path", "").startswith("[METADATA]"):
                return s

        return None

def download_dashboard(item, dest_dir):
    Aria2Session.ensure_daemon(dest_dir)
    Aria2Session.add_magnet(item["magnet"])

    sys.stdout.write("\033[?25l" + CLEAR_SCREEN)
    sys.stdout.flush()

    status_msg = ""
    is_paused = False

    try:
        while True:
            try:
                cols, lines = os.get_terminal_size()
            except Exception:
                cols, lines = 80, 24

            task = Aria2Session.get_current_task()

            status_text = task.get("status", "connecting") if task else "connecting"
            total = int(task.get("totalLength", 0)) if task else 0
            completed = int(task.get("completedLength", 0)) if task else 0
            speed = int(task.get("downloadSpeed", 0)) if task else 0
            seeders = int(task.get("numSeeders", 0)) if task else 0
            conns = int(task.get("connections", 0)) if task else 0
            gid = task.get("gid") if task else None

            file_name = item["title"]
            file_path = None
            is_metadata_phase = True

            if task and task.get("files"):
                p = task["files"][0].get("path", "")
                if p and not p.startswith("[METADATA]") and not p.startswith("[MEMORY]"):
                    is_metadata_phase = False
                    file_path = p
                    file_name = os.path.basename(p)

            pct = (completed / total * 100) if total > 0 and not is_metadata_phase else 0.0
            eta_sec = ((total - completed) / speed) if speed > 0 and total > completed else 0

            frame = [MOVE_TOP]

            hdr = f"{BOLD}{CYAN}⚡ TORQ DOWNLOAD MANAGER{RESET} {DIM}───{RESET} {BOLD}{MAGENTA}[{item['source']}]{RESET}"
            frame.append(hdr[:cols] + CLEAR_LINE)
            frame.append(f"{DIM}━" * min(cols - 1, 78) + f"{RESET}" + CLEAR_LINE)

            frame.append(f"{BOLD}File:{RESET} {WHITE}{file_name[:cols - 8]}{RESET}" + CLEAR_LINE)
            frame.append(f"{BOLD}Path:{RESET} {DIM}{dest_dir}{RESET}" + CLEAR_LINE)
            frame.append(CLEAR_LINE)

            if is_metadata_phase:
                badge = f"{MAGENTA}◐ CONNECTING TO PEERS & FETCHING METADATA...{RESET}"
            elif status_text == "active":
                badge = f"{GREEN}● DOWNLOADING{RESET}"
            elif status_text == "paused":
                badge = f"{YELLOW}❚❚ PAUSED{RESET}"
            elif status_text == "complete":
                badge = f"{BOLD}{CYAN}✔ COMPLETED{RESET}"
            elif status_text == "removed":
                badge = f"{RED}✖ CANCELLED{RESET}"
            else:
                badge = f"{YELLOW}● {status_text.upper()}{RESET}"

            frame.append(f"{BOLD}Status:{RESET} {badge}   {BOLD}Peers:{RESET} {conns} connected ({seeders} seeds)" + CLEAR_LINE)
            frame.append(CLEAR_LINE)

            bar_width = max(15, min(cols - 30, 48))
            filled = int(bar_width * pct / 100)
            empty = bar_width - filled

            fill_str = f"{BOLD}{CYAN}{'█' * filled}{RESET}"
            empty_str = f"{DIM}{'░' * empty}{RESET}"
            bar_display = f"[{fill_str}{empty_str}] {BOLD}{WHITE}{pct:5.1f}%{RESET}"
            frame.append(f"{bar_display}" + CLEAR_LINE)
            frame.append(CLEAR_LINE)

            if is_metadata_phase:
                metrics = f"{DIM}Finding best swarm seeds and resolving file pieces...{RESET}"
            else:
                metrics = (
                    f"{BOLD}Speed:{RESET} {GREEN}{format_speed(speed):<12}{RESET} "
                    f"{BOLD}Data:{RESET} {format_bytes(completed)} / {format_bytes(total)}   "
                    f"{BOLD}ETA:{RESET} {YELLOW}{format_time(eta_sec)}{RESET}"
                )
            frame.append(metrics[:cols] + CLEAR_LINE)
            frame.append(CLEAR_LINE)

            used = len(frame)
            for _ in range(max(0, lines - used - 4)):
                frame.append(CLEAR_LINE)

            if status_msg:
                frame.append(f"{CYAN}ℹ {status_msg}{RESET}" + CLEAR_LINE)
                status_msg = ""
            else:
                frame.append(f"{DIM}━" * min(cols - 1, 78) + f"{RESET}" + CLEAR_LINE)

            if status_text == "complete":
                controls = f"{BOLD}[Enter/q]{RESET} Return to Search   {BOLD}[o]{RESET} Open File in Player"
            elif status_text in ("removed", "error"):
                controls = f"{BOLD}[Enter/q]{RESET} Return to Search"
            else:
                pause_label = "Resume" if is_paused else "Pause"
                controls = (
                    f"{BOLD}[p/Space]{RESET} {pause_label}   "
                    f"{BOLD}[c]{RESET} Cancel   "
                    f"{BOLD}[b]{RESET} Run in Background   "
                    f"{BOLD}[q]{RESET} Return"
                )
            frame.append(controls[:cols] + CLEAR_LINE)

            sys.stdout.write("\n".join(frame))
            sys.stdout.flush()

            if status_text == "complete":
                send_notification("Torq Download Complete!", f"{file_name} finished downloading.")
                k = read_key()
                if k in ('o', 'O') and file_path and os.path.exists(file_path):
                    subprocess.run(["termux-open", file_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break

            if status_text in ("removed", "error"):
                read_key()
                break

            rlist, _, _ = select.select([sys.stdin], [], [], 0.6)
            if rlist:
                key = read_key()
                if key in ('p', 'P', 'SPACE') and gid:
                    if is_paused:
                        Aria2Session.unpause(gid)
                        is_paused = False
                        status_msg = "Download Resumed"
                    else:
                        Aria2Session.pause(gid)
                        is_paused = True
                        status_msg = "Download Paused"
                elif key in ('c', 'C', 'x', 'X') and gid:
                    Aria2Session.remove(gid)
                    status_msg = "Download Cancelled"
                elif key in ('b', 'B'):
                    sys.stdout.write("\033[?25h\n")
                    sys.stdout.flush()
                    print(f"\n{GREEN}✔ Download running in background!{RESET}")
                    print(f"{DIM}Saved to: {dest_dir}{RESET}\n")
                    return
                elif key in ('q', 'Q', 'QUIT'):
                    if gid:
                        Aria2Session.remove(gid)
                    break
    finally:
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()

def queue_manager(dest_dir):
    sys.stdout.write(CLEAR_SCREEN)
    v_exts = ('.mkv', '.mp4', '.avi', '.webm', '.zip', '.apk', '.iso', '.torrent')
    files = []
    if os.path.exists(dest_dir):
        for f in os.listdir(dest_dir):
            if f.endswith(v_exts) and not f.endswith('.aria2'):
                fp = os.path.join(dest_dir, f)
                try:
                    files.append((f, os.path.getsize(fp), os.path.getmtime(fp)))
                except Exception:
                    pass
    files.sort(key=lambda x: x[2], reverse=True)

    print(f"{BOLD}{CYAN}📋 TORQ DOWNLOAD MANAGER & RECENT DOWNLOADS{RESET}")
    print(f"Location: {YELLOW}{dest_dir}{RESET}")
    print(f"{DIM}━" * 65 + f"{RESET}\n")

    if not files:
        print(f"{YELLOW}No recent completed media found in {dest_dir}.{RESET}\n")
    else:
        for idx, (fname, sz, _) in enumerate(files[:15], 1):
            print(f" {BOLD}{CYAN}[{idx:2d}]{RESET} {WHITE}{fname[:50]:<52}{RESET} {YELLOW}{format_bytes(sz)}{RESET}")

    print(f"\n{DIM}━" * 65 + f"{RESET}")
    print(f"{BOLD}[1-{min(len(files), 15)}]{RESET} Open File in Player  {BOLD}[o]{RESET} Open Folder  {BOLD}[q]{RESET} Return\n")

    try:
        ch = input(f"{BOLD}Action > {RESET}").strip().lower()
        if ch == 'o':
            subprocess.run(["termux-open", dest_dir])
        elif ch.isdigit() and 1 <= int(ch) <= len(files):
            chosen_file = os.path.join(dest_dir, files[int(ch) - 1][0])
            subprocess.run(["termux-open", chosen_file])
    except Exception:
        pass

def self_update():
    """Auto-updater: updates torq directly from GitHub."""
    print(f"{CYAN}Checking for updates from GitHub...{RESET}")
    target_path = shutil.which("torq") or "/data/data/com.termux/files/usr/bin/torq"
    try:
        req = urllib.request.Request(GITHUB_RAW_URL, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            new_code = resp.read()
        if new_code:
            with open(target_path, "wb") as f:
                f.write(new_code)
            os.chmod(target_path, 0o755)
            if shutil.which("termux-fix-shebang"):
                subprocess.run(["termux-fix-shebang", target_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"{GREEN}✔ Successfully updated torq to the latest version!{RESET}")
        else:
            print(f"{RED}Update failed: empty file received.{RESET}")
    except Exception as e:
        print(f"{RED}Update failed: {e}{RESET}")

