def format_bytes(bytes_num):
    if bytes_num >= 1024**3:
        return f"{bytes_num / (1024**3):.2f} GiB"
    elif bytes_num >= 1024**2:
        return f"{bytes_num / (1024**2):.1f} MiB"
    elif bytes_num >= 1024:
        return f"{bytes_num / 1024:.1f} KiB"
    return f"{bytes_num} B"

def format_speed(bps):
    if bps >= 1024**2:
        return f"{bps / (1024**2):.2f} MiB/s"
    elif bps >= 1024:
        return f"{bps / 1024:.1f} KiB/s"
    return f"{bps} B/s"

def format_time(seconds):
    if seconds <= 0 or seconds > 86400 * 30:
        return "--:--"
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    if h > 0:
        return f"{h:d}h {m:02d}m"
    return f"{m:02d}m {s:02d}s"

def detect_quality_tier(title):
    t = title.lower()
    if re.search(r'\b(480p|360p|240p|dvdrip|camrip|hdcam|telesync|telecine|vcd|cam|ts|tc)\b', t):
        return "Low Quality (480p / SD / CAM)"
    if re.search(r'\b(2160p|4k|uhd|remux|bdremux)\b', t):
        return "Highest Quality (4K / UHD / Remux)"
    if re.search(r'\b(1080p|fhd|1080i)\b', t):
        return "High Quality (1080p / FHD / BD)"
    if (('bluray' in t or 'bdrip' in t or 'blu-ray' in t) and not re.search(r'\b(720p|480p)\b', t)):
        return "High Quality (1080p / FHD / BD)"
    if re.search(r'\b(720p|hdrip|hdtv|720i)\b', t):
        return "Medium Quality (720p / HD)"
    return "Standard / General Media"

def inject_trackers(magnet_uri, title=""):
    tr_params = "&".join(f"tr={urllib.parse.quote(tr, safe='')}" for tr in TOP_TRACKERS)
    if "magnet:?" not in magnet_uri:
        return magnet_uri
    if "&tr=" in magnet_uri:
        return f"{magnet_uri}&{tr_params}"
    else:
        dn = f"&dn={urllib.parse.quote(title)}" if title and "&dn=" not in magnet_uri else ""
        return f"{magnet_uri}{dn}&{tr_params}"

def search_tpb(query, cat=0):
    url = f"https://apibay.org/q.php?q={urllib.parse.quote(query)}"
    if cat:
        url += f"&cat={cat}"
    headers = {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Mobile Safari/537.36"
    }
    req = urllib.request.Request(url, headers=headers)
    results = []
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            for item in data:
                if item.get("name") == "No results returned":
                    continue
                info_hash = item.get("info_hash", "")
                name = item.get("name", "Untitled")
                try:
                    raw_size = int(item.get("size", 0))
                    size_str = format_bytes(raw_size)
                except Exception:
                    raw_size = 0
                    size_str = "Unknown"

                seeders = int(item.get("seeders", 0))
                leechers = int(item.get("leechers", 0))
                cat_id = item.get("category", "")
                tier = detect_quality_tier(name)

                base_magnet = f"magnet:?xt=urn:btih:{info_hash}&dn={urllib.parse.quote(name)}"
                magnet = inject_trackers(base_magnet, name)

                results.append({
                    "title": name,
                    "source": "ThePirateBay",
                    "seeders": seeders,
                    "leechers": leechers,
                    "size": size_str,
                    "raw_size": raw_size,
                    "category": f"TPB ({cat_id})",
                    "tier": tier,
                    "magnet": magnet
                })
    except Exception:
        pass
    return results

def search_nyaa(query):
    url = f"https://nyaa.si/?page=rss&q={urllib.parse.quote(query)}&s=seeders&o=desc"
    headers = {
        "User-Agent": "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Mobile Safari/537.36"
    }
    req = urllib.request.Request(url, headers=headers)
    results = []
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            content = resp.read()
            root = ET.fromstring(content)
            ns = {"nyaa": "https://nyaa.si/xmlns/nyaa"}
            for item in root.findall("./channel/item"):
                title = item.find("title").text if item.find("title") is not None else "Untitled"
                seeders = item.find("nyaa:seeders", ns)
                leechers = item.find("nyaa:leechers", ns)
                info_hash = item.find("nyaa:infoHash", ns)
                size = item.find("nyaa:size", ns)
                cat = item.find("nyaa:category", ns)

                s_val = int(seeders.text) if seeders is not None and seeders.text else 0
                l_val = int(leechers.text) if leechers is not None and leechers.text else 0
                hash_val = info_hash.text if info_hash is not None and info_hash.text else ""
                size_val = size.text if size is not None and size.text else "N/A"
                cat_val = cat.text if cat is not None and cat.text else "Anime"
                tier = detect_quality_tier(title)

                base_magnet = f"magnet:?xt=urn:btih:{hash_val}&dn={urllib.parse.quote(title)}" if hash_val else ""
                magnet = inject_trackers(base_magnet, title) if base_magnet else ""

                results.append({
                    "title": title,
                    "source": "Nyaa",
                    "seeders": s_val,
                    "leechers": l_val,
                    "size": size_val,
                    "raw_size": 0,
                    "category": cat_val,
                    "tier": tier,
                    "magnet": magnet
                })
    except Exception:
        pass
    return results

def get_downloads_dir():
    candidates = [
        "/sdcard/Download",
        os.path.expanduser("~/storage/downloads"),
        os.path.expanduser("~/Downloads"),
        os.getcwd()
    ]
    for p in candidates:
        if os.path.isdir(p) and os.access(p, os.W_OK):
            return p
    return os.getcwd()

def check_disk_space(dest_dir, required_bytes):
    try:
        _, _, free = shutil.disk_usage(dest_dir)
        if required_bytes > 0 and free < required_bytes:
            return False, free
        return True, free
    except Exception:
        return True, 0

